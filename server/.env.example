PORT=3000
NODE_ENV=development
# Supabase project > Connect > Session pooler fields (no local database/Docker).
PGHOST=aws-0-your-region.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.your-project-ref
PGPASSWORD=your-supabase-database-password
PGDATABASE=postgres
# If required by your Supabase project, download its database root certificate.
# PGSSLROOTCERT=./supabase-ca.crt
# You can use the Supabase Session Pooler URI instead of the PG* fields above.
# On Render, set this in the service's environment settings. It takes
# precedence over any partial PG* variables already configured there.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
CORS_ORIGINS=*
PAYMENT_DEMO_MODE=true
YOCO_SECRET_KEY=sk_test_replace-with-your-yoco-test-secret
YOCO_WEBHOOK_SECRET=whsec_replace-with-your-yoco-webhook-secret
# Peach Orchestration credentials are required for real PayShap payments.
PEACH_ENVIRONMENT=sandbox
PEACH_API_KEY=snd_replace-with-your-peach-api-key
PEACH_PROFILE_ID=pro_replace-with-your-peach-profile-id
PEACH_RETURN_URL=https://your-public-app.example.com/payment-return
PEACH_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Tapas <orders@your-verified-domain.com>
