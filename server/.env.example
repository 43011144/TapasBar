PORT=3000
DATABASE_URL=postgresql://tapasbar:replace-with-a-local-secret@127.0.0.1:5432/tapasbar
# Alternatively, use the exact Session Pooler fields and raw database password.
# PGHOST=your-session-pooler-host
# PGPORT=5432
# PGUSER=postgres.your-project-ref
# PGPASSWORD=your-database-password
# PGDATABASE=postgres
# For Supabase, download its database root certificate and set the local path here.
# PGSSLROOTCERT=./supabase-ca.crt
CORS_ORIGINS=*
YOCO_SECRET_KEY=sk_test_replace-with-your-yoco-test-secret
YOCO_WEBHOOK_SECRET=whsec_replace-with-your-yoco-webhook-secret
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Tapas <orders@your-verified-domain.com>
